<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================== -->
    <!-- 1. REAL ESTATE UNIT TREE VIEW (جدول عرض الوحدات)         -->
    <!-- ======================================================== -->
    <record id="view_real_estate_unit_tree" model="ir.ui.view">
        <field name="name">real.estate.unit.tree</field>
        <field name="model">real.estate.unit</field>
        <field name="arch" type="xml">
            <list string="Units">
                <field name="name"/>
                <field name="property_id"/>
                <field name="area"/>
                <field name="rooms_count"/>
                <field name="rent_price"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'vacant'" 
                       decoration-info="state == 'rented'" 
                       decoration-warning="state == 'maintenance'"/>
            </list>
        </field>
    </record>

    <!-- ======================================================== -->
    <!-- 2. REAL ESTATE UNIT FORM VIEW (نموذج تفاصيل الوحدة)      -->
    <!-- ======================================================== -->
    <record id="view_real_estate_unit_form" model="ir.ui.view">
        <field name="name">real.estate.unit.form</field>
        <field name="model">real.estate.unit</field>
        <field name="arch" type="xml">
            <form string="Real Estate Unit">
                <!-- شريط الحالة (Header Statusbar) -->
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="vacant,rented,maintenance"/>
                </header>
                <sheet>
                    <!-- اسم/رقم الوحدة -->
                    <div class="oe_title">
                        <label for="name" string="Unit Reference / Number"/>
                        <h1>
                            <field name="name" placeholder="e.g. Apt 302 / Shop A1"/>
                        </h1>
                    </div>

                    <!-- التفاصيل الرئيسية -->
                    <group>
                        <group string="Property Details">
                            <field name="property_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="rent_price"/>
                        </group>
                        <group string="Unit Specifications">
                            <field name="area"/>
                            <field name="rooms_count"/>
                        </group>
                    </group>

                    <!-- تبويب عقود الإيجار الخاصة بهذه الوحدة -->
                    <notebook>
                        <page string="Rental Contracts History" name="contracts">
                            <field name="contract_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="rent_amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======================================================== -->
    <!-- 3. REAL ESTATE UNIT KANBAN VIEW (عرض البطاقات كانبان)    -->
    <!-- ======================================================== -->
    <record id="view_real_estate_unit_kanban" model="ir.ui.view">
        <field name="name">real.estate.unit.kanban</field>
        <field name="model">real.estate.unit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="0" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="area"/>
                <field name="rooms_count"/>
                <field name="rent_price"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3 rounded shadow-sm border">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title text-primary fs-5">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted small">
                                        <i class="fa fa-building me-1"/> <field name="property_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body my-2">
                                <div class="d-flex justify-content-between small text-secondary">
                                    <span><i class="fa fa-arrows-alt me-1"/> <field name="area"/> sqm</span>
                                    <span><i class="fa fa-bed me-1"/> <field name="rooms_count"/> Rooms</span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                <div class="fw-bold text-success fs-6">
                                    <field name="rent_price"/>
                                </div>
                                <div>
                                    <field name="state" widget="badge" 
                                           decoration-success="state == 'vacant'" 
                                           decoration-info="state == 'rented'" 
                                           decoration-warning="state == 'maintenance'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ======================================================== -->
    <!-- 4. REAL ESTATE UNIT SEARCH VIEW (البحث والفلترة)         -->
    <!-- ======================================================== -->


    <!-- ======================================================== -->
    <!-- 5. ACTION                                                -->
    <!-- ======================================================== -->
    <record id="action_real_estate_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">real.estate.unit</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first real estate unit!
            </p>
            <p>
                Manage apartments, offices, and shops across properties.
            </p>
        </field>
    </record>

</odoo>