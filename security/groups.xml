<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================== -->
        <!-- 1. Module Category & Privilege                 -->
        <!-- ============================================== -->
        <record id="module_category_real_estate" model="ir.module.category">
            <field name="name">Real Estate</field>
            <field name="description">Helps you manage real estate properties, units, contracts, and payments.</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_real_estate" model="res.groups.privilege">
            <field name="name">Real Estate</field>
            <field name="category_id" ref="module_category_real_estate"/>
            <field name="sequence">20</field>
        </record>

        <!-- ============================================== -->
        <!-- 2. Groups                                      -->
        <!-- ============================================== -->
        <record id="group_real_estate_sales_agent" model="res.groups">
            <field name="name">Sales Agent</field>
            <field name="privilege_id" ref="privilege_real_estate"/>
            <field name="sequence">1</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_real_estate_property_manager" model="res.groups">
            <field name="name">Property Manager</field>
            <field name="privilege_id" ref="privilege_real_estate"/>
            <field name="sequence">2</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_real_estate_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="privilege_id" ref="privilege_real_estate"/>
            <field name="sequence">3</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_real_estate_general_manager" model="res.groups">
            <field name="name">General Manager</field>
            <field name="privilege_id" ref="privilege_real_estate"/>
            <field name="sequence">4</field>
            <field name="implied_ids" eval="[
                (4, ref('group_real_estate_sales_agent')),
                (4, ref('group_real_estate_property_manager')),
                (4, ref('group_real_estate_accountant'))
            ]"/>
        </record>

        <!-- ============================================== -->
        <!-- 3. Assign GM Group to Admin Users Automatically -->
        <!-- ============================================== -->
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('group_real_estate_general_manager'))]"/>
        </record>

        <record id="base.user_root" model="res.users">
            <field name="group_ids" eval="[(4, ref('group_real_estate_general_manager'))]"/>
        </record>

        <!-- ============================================== -->
        <!-- 4. Record Rules - Contracts                    -->
        <!-- ============================================== -->
        <record id="rule_real_estate_contract_sales_agent_own" model="ir.rule">
            <field name="name">Sales agents: own rental contracts only</field>
            <field name="model_id" ref="model_real_estate_rental_contract"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_real_estate_sales_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_real_estate_contract_manager_all" model="ir.rule">
            <field name="name">Managers &amp; Accountant: all rental contracts</field>
            <field name="model_id" ref="model_real_estate_rental_contract"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_real_estate_property_manager')),
                (4, ref('group_real_estate_accountant')),
                (4, ref('group_real_estate_general_manager'))
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================== -->
        <!-- 5. Record Rules - Payments                     -->
        <!-- ============================================== -->
        <record id="rule_real_estate_payment_sales_agent_own" model="ir.rule">
            <field name="name">Sales agents: payments of own contracts only</field>
            <field name="model_id" ref="model_real_estate_rental_payment"/>
            <field name="domain_force">[('contract_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_real_estate_sales_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_real_estate_payment_accountant_manager_all" model="ir.rule">
            <field name="name">Accountant &amp; Property Manager: all rental payments</field>
            <field name="model_id" ref="model_real_estate_rental_payment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('group_real_estate_property_manager')),
                (4, ref('group_real_estate_accountant')),
                (4, ref('group_real_estate_general_manager'))
            ]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>